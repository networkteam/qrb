{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.14.0/.schema/devbox.schema.json",
  "packages": [
    "go@1.25.11",
    "golangci-lint@2.12.2"
  ],
  "shell": {
    "scripts": {
      "test": [
        "go test ./...",
        "(cd examples/libpq && go test ./...)",
        "(cd examples/pgx && go test ./...)"
      ],
      "lint": [
        "golangci-lint run ./...",
        "(cd examples/libpq && golangci-lint run ./...)",
        "(cd examples/pgx && golangci-lint run ./...)"
      ]
    }
  }
}
